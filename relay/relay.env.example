# /etc/meetingly-relay.env  (chmod 600, owned by root)
# Any OpenAI-compatible endpoint (the hosted relay uses the claudeshop.store gateway).
UPSTREAM_BASE_URL=https://claudeshop.store/v1
UPSTREAM_API_KEY=
DEEPGRAM_API_KEY=
# Shared secret baked into the desktop app (shared/relay.ts). Rotate both together.
APP_TOKEN=
# Behind nginx on Voyra: plain HTTP on localhost, nginx terminates TLS and strips the /igpt/ prefix.
HOST=127.0.0.1
PORT=8090
TRUST_PROXY=1
# Set both to serve TLS directly instead (no nginx in front).
# TLS_CERT=/etc/meetingly-relay/fullchain.pem
# TLS_KEY=/etc/meetingly-relay/key.pem
# The app never picks a model; it labels each request with a task and the relay decides per plan.
# DEFAULT_MODEL serves everything; MODEL_FREE / MODEL_PRO / MODEL_UNLIMITED set a plan's model;
# MODEL_ANSWER / MODEL_SUGGEST / MODEL_VISION / MODEL_REPORT set a task on every plan; MODEL_<PLAN>_<TASK>
# sets one task on one plan. FALLBACK_MODEL (or FALLBACK_MODEL_<PLAN>) is tried when the first choice
# fails before answering. Restart to apply.
DEFAULT_MODEL=gpt-5.6-luna
FALLBACK_MODEL=gpt-5.5
# MODEL_PRO=
# MODEL_UNLIMITED=
# FALLBACK_MODEL_UNLIMITED=
# claude-* models go to their own OpenAI-compatible gateway when these are set (else to UPSTREAM_*).
# CLAUDE_BASE_URL=https://aiprimetech.io/v1
# CLAUDE_API_KEY=
# Reasoning models spend part of this on thinking; keep headroom.
MAX_TOKENS=4096
# Absolute requests per account per day, whatever they are. Plan budgets (and requests per minute and at
# once per plan) live in plans.mjs.
CHAT_PER_DAY=2000
RPM_PER_IP=60
USAGE_FILE=/var/lib/meetingly-relay/usage.json
