# /etc/meetingly-relay.env  (chmod 600, owned by root)
# Any OpenAI-compatible endpoint. Default is the claudeshop.store gateway (sub2api on this same box).
UPSTREAM_BASE_URL=https://claudeshop.store/v1
UPSTREAM_API_KEY=
DEEPGRAM_API_KEY=
# Shared secret baked into the desktop app (shared/relay.ts). Rotate both together.
APP_TOKEN=
# Behind nginx on Voyra: plain HTTP on localhost, nginx terminates TLS and strips the /igpt/ prefix.
HOST=127.0.0.1
PORT=8090
TRUST_PROXY=1
# Set both to serve TLS directly instead (no nginx in front).
# TLS_CERT=/etc/meetingly-relay/fullchain.pem
# TLS_KEY=/etc/meetingly-relay/key.pem
# The app never picks a model; it labels each request with a task and the relay decides.
# DEFAULT_MODEL serves every task, MODEL_ANSWER / MODEL_SUGGEST / MODEL_VISION / MODEL_REPORT
# override one task, FALLBACK_MODEL is tried when the first choice fails. Restart to apply.
DEFAULT_MODEL=gpt-5.6-luna
FALLBACK_MODEL=gpt-5.5
# Reasoning models spend part of this on thinking; keep headroom.
MAX_TOKENS=4096
CHAT_PER_DAY=2000
AUDIO_MINUTES_PER_DAY=300
RPM_PER_IP=60
USAGE_FILE=/var/lib/meetingly-relay/usage.json
